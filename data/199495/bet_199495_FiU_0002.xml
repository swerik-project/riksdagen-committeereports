  <text>
    <body>
      <div type="cBody">
        <div rend="sidhuvud_publikation">
          <p>
            Finansutskottets betänkande
          </p>
        </div>
        <div rend="sidhuvud_beteckning">
          <p>
            1994/95:FIU02
          </p>
        </div>
        <div type="section" subtype="h1">
          <head>
            Riksdagens revisorers verksamhet under budgetåret 1993/94 (redog.
            1994/95:RR1)
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Utskottet
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bhemst">
                    Hemställan
                  </ref>
                </p>
              </item>
            </list>
            <p>
              1994/95
            </p>
            <p>
              FiU2 Redogörelsen
            </p>
            <p>
              Riksdagens revisorer har till riksdagen överlämnat en berättelse
              om sin verksamhet under budgetåret 1993/94 (1994/95:RR1).
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bsam">
              Utskottet
            </head>
            <p>
              Utskottet har vid sin genomgång av berättelsen inte funnit något
              som påkallar särskilt uttalande från riksdagens sida.
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bhemst">
              Hemställan
            </head>
            <p>
              Utskottet hemställer
            </p>
            <p>
              beträffande Riksdagens revisorers verksamhet under budgetåret
              1993/94 att riksdagen lägger redogörelse 1994/95:RR1 till handlingarna.
            </p>
            <p>
              Stockholm den 22 november 1994
            </p>
            <p>
              På finansutskottets vägnar
            </p>
            <p>
              Jan Bergqvist
            </p>
            <p>
              I beslutet har deltagit:
            </p>
            <p>
              Jan Bergqvist (s), Per Olof Håkansson (s), Lars Tobisson (m),
              Lisbet Calner (s), Yvonne Sandberg-Fries (s), Arne Kjörnsberg
              (s), Lennart Hedquist (m), Anne Wibble (fp), Sonia Karlsson (s),
              Johan Lönnroth (v), Susanne Eberstein (s), Roy Ottosson (mp),
              Mats Odell (kds), Kristina Persson (s) och Per Bill (m).
            </p>
          </div>
        </div>
      </div>
