        <div type="section" subtype="h1">
          <head>
            Anslag till Bokföringsnämnden, m.m.
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Sammanfattning
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bprop">
                    Propositionen
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bmot">
                    Utskottet
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
