        <div type="section" subtype="h1">
          <head>
            Sammanställning av anslag på tilläggsbudget våren 1995
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Utskottet
                  </ref>
                </p>
              </item>
