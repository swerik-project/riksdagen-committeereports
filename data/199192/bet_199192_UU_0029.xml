        <div type="section" subtype="h1">
          <head>
            Godkännande av protokoll nr 10 till konventionen angående skydd
            för de mänskliga rättigheterna och de grundläggande friheterna
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Propositionen
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bmot">
