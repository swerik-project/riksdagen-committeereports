  <text>
    <body>
      <div type="cBody">
        <div rend="sidhuvud_publikation">
          <p>
            Kulturutskottets betänkande
          </p>
        </div>
        <div rend="sidhuvud_beteckning">
          <p>
            1991/92:KRU30
          </p>
        </div>
        <div type="section" subtype="h1">
          <head>
            Uppskov med behandlingen av vissa ärenden
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Utskottet
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bhemst">
                    Hemställan
                  </ref>
                </p>
              </item>
            </list>
            <p>
              1991/92 KrU30
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bsam">
              Utskottet
            </head>
            <p>
              Kulturutskottet har funnit att nedan angivna ärenden inte hinner
              behandlas före utgången av innevarande riksmöte och att behandlingen
              av dem därför bör skjutas upp till riksmötet 1992/93.
            </p>
            <p>
              Fristående motioner
            </p>
            <p>
              Kulturmiljövård
            </p>
            <p>
              1991/92:Kr223 av Sigrid Bolkéus och Gunnar Thollander (s) Ortnamn
            </p>
            <p>
              1991/92:Kr224 av Bertil Persson (m) Glimmingehus som världsskatt
            </p>
            <p>
              1991/92:Kr242 av Sten Svensson (m) Arkeologiska kostnader vid
              byggande
            </p>
            <p>
              1991/92:Kr245 av Jan Backman (m) Råå vallar
            </p>
            <p>
              1991/92:Kr266 av Elisabeth Fleetwood (m) Restaureringen av 1700-talsorgeln
              i Loftahammars församling
            </p>
            <p>
              1991/92:Kr267 av Elisabeth Fleetwood m.fl. (m) Väderskärs kapell
            </p>
            <p>
              1991/92:Kr268 av Stina Gustavsson och Sigge Godin (c, fp) Ortnamn
            </p>
            <p>
              1991/92:Kr275 av Erling Bager (fp) 1000-årsminnet av Olof Skötkonung
            </p>
