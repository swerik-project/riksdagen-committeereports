        <div type="section" subtype="h1">
          <head>
            Sändning av grannländers rundradioprogram från sändare i Sverige
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Propositionen
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
