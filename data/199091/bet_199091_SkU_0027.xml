          <p>
            1990/91:SKU27
          </p>
        </div>
        <div type="section" subtype="h1">
          <head>
            Ändring i kupongskattelagen
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Propositionen
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bmot">
                    Utskottet
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
