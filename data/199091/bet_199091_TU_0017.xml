  <text>
    <body>
      <div type="cBody">
        <div rend="sidhuvud_publikation">
          <p>
            Trafikutskottets betänkande
          </p>
        </div>
        <div rend="sidhuvud_beteckning">
          <p>
            1990/91:TU17
          </p>
        </div>
        <div type="section" subtype="h1">
          <head>
            Anslag till Statens telenämnd
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Utskottet
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bhemst">
                    Hemställan
                  </ref>
                </p>
              </item>
            </list>
            <p>
              1990/91 TU17
            </p>
            <p>
              SJÄTTE HUVUDTITELN
            </p>
            <p>
              Statens telenämnd
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bsam">
              Utskottet
            </head>
            <p>
              Utskottet tillstyrker regeringens förslag i proposition 1990/91:100
              bilaga 8 (kommunikationsdepartementet) i avsnitt J. Telekommunikationer
              under rubriken J1. Statens telenämnd (s. 132--133).
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bhemst">
              Hemställan
            </head>
            <p>
              Utskottet hemställer
            </p>
            <p>
              att riksdagen till Statens telenämnd för budgetåret 1991/92 anvisar
              ett förslagsanslag på 4019000 kr.
            </p>
            <p>
              Stockholm den 7 mars 1991
            </p>
            <p>
              På trafikutskottets vägnar
            </p>
            <p>
              Birger Rosqvist
            </p>
            <p>
              Närvarande: Birger Rosqvist (s), Ove Karlsson (s), Olle Östrand
              (s), Elving Andersson (c), Sven-Gösta Signell (s), Görel Bohlin
              (m), Margit Sandéhn (s), Sten-Ove Sundström (s), Sten Andersson
              i Malmö (m), Hugo Bergdahl (fp), Rune Thorén (c), Viola Claesson
              (v), Roy Ottosson (mp), Jarl Lander (s), Yngve Wernersson (s),
              Tom Heyman (m) och Anders Castberger (fp).
            </p>
          </div>
        </div>
      </div>
