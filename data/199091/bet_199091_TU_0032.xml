  <text>
    <body>
      <div type="cBody">
        <div rend="sidhuvud_publikation">
          <p>
            Trafikutskottets betänkande
          </p>
        </div>
        <div rend="sidhuvud_beteckning">
          <p>
            1990/91:TU32
          </p>
        </div>
        <div type="section" subtype="h1">
          <head>
            Tilläggsbudget II inom kommunikationsdepartementets område
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Utskottet
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bhemst">
                    Hemställan
                  </ref>
                </p>
              </item>
            </list>
            <p>
              1990/91
            </p>
            <p>
              TU32
            </p>
            <p>
              SJÄTTE HUVUDTITELN
            </p>
            <p>
              A 2. Utredningar m.m.
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bsam">
              Utskottet
            </head>
            <p>
              Utskottet tillstyrker regeringens förslag i proposition 1990/91:125
              bilaga 4 (kommunikationsdepartementet) under punkt A 2 (s. 9).
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bhemst">
              Hemställan
            </head>
            <p>
              Utskottet hemställer att riksdagen till Utredningar m.m. på tilläggsbudget
              II till statsbudgeten för budgetåret 1990/91 anvisar ett reservationsanslag
              på 2000000kr.
            </p>
            <p>
              Stockholm den 14 maj 1991
            </p>
            <p>
              På trafikutskottets vägnar
            </p>
            <p>
              Birger Rosqvist
            </p>
            <p>
              Närvarande: Birger Rosqvist (s), Rolf Clarkson (m), Olle Östrand
              (s), Kenth Skårvik (fp), Elving Andersson (c), Sven-Gösta Signell
              (s), Görel Bohlin (m), Margit Sandéhn (s), Rune Johansson (s),
              Sten-Ove Sundström (s), Sten Andersson i Malmö (m), Hugo Bergdahl
              (fp), Rune Thorén (c), Viola Claesson (v), Roy Ottosson (mp),
              Jarl Lander (s) och Yngve Wernersson (s).
            </p>
          </div>
        </div>
      </div>
