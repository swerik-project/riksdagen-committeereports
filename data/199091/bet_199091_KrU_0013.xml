  <text>
    <body>
      <div type="cBody">
        <div rend="sidhuvud_publikation">
          <p>
            Kulturutskottets betänkande
          </p>
        </div>
        <div rend="sidhuvud_beteckning">
          <p>
            1990/91:KRU13
          </p>
        </div>
        <div type="section" subtype="h1">
          <head>
            Anslag till medlemskap i Unesco
          </head>
          <milestone rend="sidhuvud_linje" unit="horizontal-rule"/>
          <div type="section" subtype="h2">
            <head>
              Innehåll
            </head>
            <list type="unordered">
              <item rend="innehall_lista">
                <p>
                  <ref target="#bsam">
                    Utskottet
                  </ref>
                </p>
              </item>
              <item rend="innehall_lista">
                <p>
                  <ref target="#bhemst">
                    Hemställan
                  </ref>
                </p>
              </item>
            </list>
            <p>
              1990/91 KrU13
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bsam">
              Utskottet
            </head>
            <p>
              Utskottet tillstyrker det förslag regeringen lagt fram i proposition
              1990/91:100 bil. 10 (utbildningsdepartementet) under punkt A 3
              (s. 39--40).
            </p>
          </div>
          <div type="section" subtype="h2">
            <head xml:id="bhemst">
              Hemställan
            </head>
            <p>
              Utskottet hemställer
            </p>
            <p>
              beträffande Kostnader för Sveriges medlemskap i Unesco m.m.
            </p>
            <p>
              att riksdagen till Kostnader för Sveriges medlemskap i Unesco
              m.m. för budgetåret 1991/92 under åttonde huvudtiteln anvisar
              ett förslagsanslag på 21744000kr.
            </p>
            <p>
              Stockholm den 21 februari 1991
            </p>
            <p>
              På kulturutskottets vägnar
            </p>
            <p>
              Ingrid Sundberg
            </p>
            <p>
              Närvarande: Ingrid Sundberg (m), Åke Gustavsson (s), Maja Bäckström
              (s), Berit Oscarsson (s), Lars Ernestam (fp), Jan Hyttring (c),
              Anders Nilsson (s), Lars Ahlmark (m), Sylvia Pettersson (s), Erkki
              Tammenoksa (s), Leo Persson (s), Lars Ahlström (m), Margareta
              Fogelberg (fp), Stina Gustavsson (c), Alexander Chrisopoulos (v),
              Kaj Nilsson (mp) och Ulla Berg (s).
            </p>
          </div>
        </div>
      </div>
