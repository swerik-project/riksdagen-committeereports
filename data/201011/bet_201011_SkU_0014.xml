            <p>
              <graphic url="http://data.riksdagen.se/fil/gy01sku14/shape{3DEE2837-4D03-4361-8336-81231BABAADF}.png"/>
            </p>
            <p>
              <graphic url="http://data.riksdagen.se/fil/gy01sku14/shape{6DE2B419-D5FF-4126-B635-7304AF251A68}.png"/>
            </p>
            <p>
              <graphic url="http://data.riksdagen.se/fil/gy01sku14/shape{3CA63944-6CEB-4281-AAD9-E288F4810221}.png"/>
