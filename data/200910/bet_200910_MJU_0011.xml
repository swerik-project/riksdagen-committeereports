        <div rend="betankande_">
          <table>
            <row>
              <cell>
                <p rend="HuvudRubrik_">
                  Miljö- och jordbruksutskottets betänkande
                </p>
                <p rend="HuvudRubrikRad2_">
                  2009/10:MJU11
                </p>
              </cell>
              <cell/>
            </row>
            <row>
              <cell>
                <p rend="DokumentRubrik_">
                  Ändringar i systemet för handel med utsläppsrätter
                </p>
              </cell>
            </row>
            <row>
