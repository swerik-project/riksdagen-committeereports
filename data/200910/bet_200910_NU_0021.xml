          <p rend="justeringsdatum">
            Stockholm den 29 april 2010
          </p>
          <p>
            På näringsutskottets vägnar
          </p>
          <p rend="ordforanden_">
            Carl B Hamilton
          </p>
          <p rend="deltagare_">
