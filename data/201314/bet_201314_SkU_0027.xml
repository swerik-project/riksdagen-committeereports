            <p xml:id="IDAV4ABD" rend="rubrik2">
              Propositionen
            </p>
            <p rend="behandlatdokument_">
              Proposition 2013/14:105 Informationsutbytesavtal med Qatar:
            </p>
            <table>
              <row>
                <cell>
                  <p>
                    1.
                  </p>
                </cell>
                <cell>
                  <p>
                    Riksdagen godkänner avtalet mellan Sverige och Qatar om utbyte
                    av upplysningar i skatteärenden.
                  </p>
                </cell>
              </row>
              <row>
