        <div rend="betankande_">
          <table>
            <row>
              <cell>
                <p rend="HuvudRubrik_">
                  Skatteutskottets betänkande
                </p>
                <p rend="HuvudRubrikRad2_">
                  2012/13:SkU4
                </p>
              </cell>
