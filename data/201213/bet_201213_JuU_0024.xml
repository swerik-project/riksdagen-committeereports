          <p xml:id="IDAEXCLC" rend="rubrik2">
            Förfalsknings- och sanningsbrotten
          </p>
          <div rend="ruta_">
            <p xml:id="IDAKXCLC" rend="rubrikiruta_">
              Utskottets förslag i korthet
            </p>
